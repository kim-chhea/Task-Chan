VITE_APP_NAME="Task-Chan"
# Dev: Vite proxies /api and /sanctum to the backend.
BACKEND_URL=http://localhost:8000
# Production, API on another origin. CSP_CONNECT_SRC must list that origin too (same value as Laravel).
# The build fails if VITE_API_URL's origin is missing from CSP_CONNECT_SRC.
# VITE_API_URL=https://api.example.com
# CSP_CONNECT_SRC=https://api.example.com
